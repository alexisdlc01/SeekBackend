NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/seek
REDIS_URL=redis://127.0.0.1:6379
FRONTEND_URL=http://localhost:5173
# Outside production, any http://localhost[:port] / 127.0.0.1[:port] origin is also allowed (CORS).
# Public base URL of this API, used in links Seek builds to its own pages (contract documents).
API_URL=http://localhost:3000
MORGAN_FORMAT=dev

JWT_ACCESS_TOKEN_SECRET=replace-with-a-long-local-access-secret
JWT_REFRESH_TOKEN_SECRET=replace-with-a-long-local-refresh-secret
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

AUTH_EMAIL_VERIFICATION_ENABLED=false
AUTH_GOOGLE_ENABLED=false
AUTH_MAX_REFRESH_SESSIONS=10
AUTH_EMAIL_VERIFICATION_TTL_MS=600000
AUTH_EMAIL_VERIFICATION_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_MS=60000
AUTH_OTP_RATE_WINDOW_MS=3600000
AUTH_OTP_MAX_SENDS_PER_WINDOW=5
AUTH_PASSWORD_RESET_TTL_MS=1800000
AUTH_PASSWORD_RESET_COOLDOWN_MS=60000
AUTH_PASSWORD_RESET_RATE_WINDOW_MS=3600000
AUTH_PASSWORD_RESET_MAX_SENDS_PER_WINDOW=5
MOBILE_PASSWORD_RESET_URL=seekapp://link/reset-password
FRONTEND_PASSWORD_RESET_URL=http://localhost:5173/confirmResetPassword

GOOGLE_CLIENT_ID=local-placeholder
GOOGLE_CLIENT_SECRET=local-placeholder
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_GEOCODING_API_KEY=local-placeholder

MAILGUN_API_KEY=local-placeholder
MAILGUN_DOMAIN=local-placeholder

AWS_S3_REGION=eu-west-1
AWS_ACCESS_KEY_ID=local-placeholder
AWS_SECRET_ACCESS_KEY=local-placeholder
AWS_PUBLIC_BUCKET=local-placeholder
AWS_PRIVATE_BUCKET=local-placeholder

# Rent payments. Leave STRIPE_SECRET_KEY empty to use simulated payments
# (development only; production without a key answers 503).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends a landlord after payout setup. Default to FRONTEND_URL/landlord/payments?connect=...
STRIPE_CONNECT_RETURN_URL=
STRIPE_CONNECT_REFRESH_URL=
PAYMENTS_SWEEP_INTERVAL_MS=3600000

# Password given to every user created by `npm run db:reset` / `npm run db:seed`.
SEED_PASSWORD=

# AI search and advice. Providers are tried in order: Gemini, then Anthropic,
# then the built-in rule-based parser (no network calls). Leave both keys
# empty to use the rules only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Used when GEMINI_MODEL fails or hits its quota (429); a 429 model is skipped for 10 minutes.
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# GDPR: when false, inbox advice sends only subject, sender and date to the
# model, never the email body.
AI_SEND_EMAIL_CONTENT=false

# Email connectors. Gmail needs a Google OAuth client with the gmail.readonly
# and gmail.send scopes; Outlook needs a Microsoft Entra app with Mail.Read and
# Mail.Send. Without them only the demo mailbox is offered (never in production).
# Redirect URIs to register: <CONNECTORS_CALLBACK_BASE_URL>/connectors/gmail/callback
# and <CONNECTORS_CALLBACK_BASE_URL>/connectors/outlook/callback.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# 32 bytes as 64 hex characters (openssl rand -hex 32). Encrypts stored mailbox
# tokens (AES-256-GCM). Required in production; development derives a local key.
CONNECTOR_ENCRYPTION_KEY=
CONNECTORS_CALLBACK_BASE_URL=http://localhost:3000
MOBILE_CONNECTORS_REDIRECT_URL=seekapp://connectors

# Real e-mails (Mailgun) are skipped in development/test; set true to send from a dev machine.
MAIL_SEND_OUTSIDE_PRODUCTION=false
