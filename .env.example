NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/seek
REDIS_URL=redis://127.0.0.1:6379
FRONTEND_URL=http://localhost:5173
MORGAN_FORMAT=dev

JWT_ACCESS_TOKEN_SECRET=replace-with-a-long-local-access-secret
JWT_REFRESH_TOKEN_SECRET=replace-with-a-long-local-refresh-secret
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

AUTH_EMAIL_VERIFICATION_ENABLED=false
AUTH_GOOGLE_ENABLED=false
AUTH_MAX_REFRESH_SESSIONS=10
AUTH_EMAIL_VERIFICATION_TTL_MS=600000
AUTH_EMAIL_VERIFICATION_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_MS=60000
AUTH_OTP_RATE_WINDOW_MS=3600000
AUTH_OTP_MAX_SENDS_PER_WINDOW=5
AUTH_PASSWORD_RESET_TTL_MS=1800000
AUTH_PASSWORD_RESET_COOLDOWN_MS=60000
AUTH_PASSWORD_RESET_RATE_WINDOW_MS=3600000
AUTH_PASSWORD_RESET_MAX_SENDS_PER_WINDOW=5
MOBILE_PASSWORD_RESET_URL=seekapp://link/reset-password
FRONTEND_PASSWORD_RESET_URL=http://localhost:5173/confirmResetPassword

GOOGLE_CLIENT_ID=local-placeholder
GOOGLE_CLIENT_SECRET=local-placeholder
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_GEOCODING_API_KEY=local-placeholder

MAILGUN_API_KEY=local-placeholder
MAILGUN_DOMAIN=local-placeholder

AWS_S3_REGION=eu-west-1
AWS_ACCESS_KEY_ID=local-placeholder
AWS_SECRET_ACCESS_KEY=local-placeholder
AWS_PUBLIC_BUCKET=local-placeholder
AWS_PRIVATE_BUCKET=local-placeholder
